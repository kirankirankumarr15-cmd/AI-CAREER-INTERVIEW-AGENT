# ================================================================
# PRISM — Placement Readiness Intelligence & Skill Measurement
# Environment Configuration (.env.example)
# ================================================================

# ─── Claude API (Anthropic — Server-side AI features) ───
ANTHROPIC_API_KEY=your-anthropic-claude-api-key
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# ─── Supabase (Postgres, Auth, Storage, Row Level Security) ───
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project.supabase.co:5432/postgres

# ─── AI Fallbacks (OpenAI / Gemini optional) ───
AI_PROVIDER=claude
OPENAI_API_KEY=
GEMINI_API_KEY=

# ─── Email Dispatch (SMTP for Student Verification / Password Reset) ───
GMAIL_USER=placement-cell@pesitm.edu.in
GMAIL_APP_PASSWORD=your-16-char-app-password
EMAIL_FROM_NAME="PRISM Placement Cell"
