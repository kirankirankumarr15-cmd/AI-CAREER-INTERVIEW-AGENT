# ================================================================
# PRISM — Placement Readiness Intelligence & Skill Measurement
# Environment Configuration (.env.example)
# ================================================================

# ─── Primary Local Persistent Database (SQLite WAL mode) ───
DATABASE_ENGINE=sqlite
DATABASE_PATH=data/careerpilot.db

# ─── Supabase (Postgres, Auth, Storage, Row Level Security) ───
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Use either the legacy anon key or the newer publishable key name
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project.supabase.co:5432/postgres

# ─── Claude API (Anthropic — Server-side AI features) ───
ANTHROPIC_API_KEY=your-anthropic-claude-api-key
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# ─── AI Fallbacks (OpenAI / Gemini optional) ───
AI_PROVIDER=gemini
OPENAI_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# ─── Email Dispatch (SMTP for Student Verification / Password Reset) ───
GMAIL_USER=placement-cell@pesitm.edu.in
GMAIL_APP_PASSWORD=your-16-char-app-password
EMAIL_FROM_NAME="PRISM Placement Cell"
