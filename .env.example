# ==========================================
# CareerPilot AI — Environment Configuration
# ==========================================

# ─── Supabase (Auth, Postgres, Vector, Private Storage) ───
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-side Postgres Connection (used for applying migrations)
DATABASE_URL=postgresql://postgres.your-project:your-db-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# ─── AI Engine (Server-side Only) ───
# Active provider: 'openai' (recommended for ChatGPT-style experience) or 'gemini'
AI_PROVIDER=openai

# OpenAI Configuration (https://platform.openai.com/api-keys)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_STT_MODEL=whisper-1
OPENAI_TTS_MODEL=tts-1

# Google Gemini API Key (Dual-provider fallback for embeddings and question generation)
GEMINI_API_KEY=


# ─── Email Dispatch (SMTP for Real OTP verification) ───
# Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-gmail-16-char-app-password
EMAIL_FROM_NAME="CareerPilot AI"

# ─── WhatsApp Cloud API Integration (Optional / Production) ───
WHATSAPP_API_TOKEN=your-meta-whatsapp-system-user-token
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-webhook-verification-token
